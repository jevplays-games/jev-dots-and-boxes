{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"jev-dots-and-boxes",
  "main":"src/worker.js",
  "compatibility_date":"2026-09-01",
  "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "d1_databases":[{"binding":"DB","database_name":"dots-and-boxes","database_id":"REPLACE_WITH_CREATED_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "vars":{"APP_ORIGIN":"https://REPLACE_WITH_YOUR_DOMAIN","JEV_MODEL":"jev-1.13.0","SOURCE_REVISION":"REPLACE_WITH_COMMIT_SHA","DEPLOYMENT_ID":"production-v1","MAX_PROVIDER_CALLS_PER_DAY":"2000","MAX_SESSIONS_PER_HOUR":"300","JEV_TIMEOUT_MS":"5000","PRACTICE_RETENTION_DAYS":"90"},
  "triggers":{"crons":["0 * * * *"]},
  "observability":{"enabled":false}
}
