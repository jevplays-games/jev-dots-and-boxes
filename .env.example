# Copy to .env. Never commit real credentials.
PORT=8787
APP_ORIGIN=http://127.0.0.1:8787
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
SOURCE_REVISION=local-development
DEPLOYMENT_ID=local
MAX_PROVIDER_CALLS_PER_DAY=2000
MAX_SESSIONS_PER_HOUR=300
JEV_TIMEOUT_MS=5000
# Optional explicitly configured rates. Blank means cost UNKNOWN, not free.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
