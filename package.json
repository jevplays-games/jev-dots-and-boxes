{
  "name": "jev-box-score",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Box Score: claim boxes against Jev with authoritative matches and detailed auditable analytics",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "benchmark": "node bench/run.mjs",
    "audit": "node scripts/audit.mjs",
    "export": "node scripts/export.mjs",
    "test:browser": "python scripts/browser-test.py",
    "deploy": "npx wrangler deploy",
    "db:migrate": "npx wrangler d1 migrations apply dots-and-boxes --remote",
    "deploy:godaddy": "node --env-file-if-exists=.env scripts/godaddy-deploy.js"
  }
}
